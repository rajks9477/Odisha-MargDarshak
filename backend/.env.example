# ==============================================================================
# NER-MargDarshak Backend Environment Configuration
# ==============================================================================

# Project & Metadata
PROJECT_NAME="NER-MargDarshak Intelligence Platform"
ENVIRONMENT="production" # development, staging, production
DEBUG=false

# API Server Configuration
API_V1_STR="/api/v1"
HOST="0.0.0.0"
PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://nermargdarshak.gov.in"]

# Security & Authentication
JWT_SECRET_KEY="REPLACE_WITH_STRONG_RANDOM_HEX_64_CHARACTERS"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL 16 + PostGIS 3.4)
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="REPLACE_WITH_SECURE_PASSWORD"
POSTGRES_SERVER="db"
POSTGRES_PORT=5432
POSTGRES_DB="nermargdarshak"
DATABASE_URL="postgresql+asyncpg://postgres:REPLACE_WITH_SECURE_PASSWORD@db:5432/nermargdarshak"

# Redis & Event Message Bus
REDIS_URL="redis://redis:6379/0"

# External Data Connectors & APIs (Ground Provenance)
IMD_API_KEY="DEMO_KEY_IMD_GOV_IN"
ISRO_BHUVAN_API_KEY="DEMO_KEY_NRSC_BHUVAN"
MORTH_GIS_ENDPOINT="https://morth.nic.in/gis/v1"
SACHET_NDMA_FEED="https://sachet.ndma.gov.in/cap/rss/ner-region"
